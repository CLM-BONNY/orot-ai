        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "body_markdown": {
          "type": "string",
          "minLength": 1
        },
        "previous_page_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^CH\\d{2}-P\\d{2}$"
            },
            {
              "type": "null"
