    "single_choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CH\\d{2}-[QR]\\d{2}|CAP\\d{2}|GQ-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        },
        "format": {
          "const": "single_choice"
        },
        "origin": {
          "enum": [
            "authored",
            "generated"
          ]
        },
        "content_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_page_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}-P\\d{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt_markdown": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "not_rated",
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "correct_option_id": {
          "type": "string",
          "pattern": "^(CH\\d{2}-Q\\d{2}|GQ-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}):[A-D]$"
        },
        "explanation_markdown": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^GEN-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "format",
        "origin",
        "content_version",
        "chapter_ids",
        "concept_ids",
        "source_page_ids",
        "prompt_markdown",
        "category",
        "difficulty",
        "options",
        "correct_option_id",
        "explanation_markdown",
        "generation_id",
        "revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "authored"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^CH\\d{2}-Q\\d{2}$"
              },
              "generation_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "pattern": "^GQ-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "generation_id": {
                "type": "string",
                "pattern": "^GEN-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
