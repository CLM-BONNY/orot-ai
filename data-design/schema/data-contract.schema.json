{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineer learning content and local record contracts",
  "description": "Version 1.0.0; foreign keys and revision integrity require validate_data.py.",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "introduction_markdown": {
          "type": "string",
          "minLength": 1
        },
        "chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "title",
        "order",
        "introduction_markdown",
        "chapter_ids",
        "source_ids",
        "source_file",
        "revision"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CH\\d{2}$"
        },
        "track_id": {
          "type": "string",
          "pattern": "^T\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "prerequisite_chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "page_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}-P\\d{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(CH\\d{2}-[QR]\\d{2}|CAP\\d{2}|GQ-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
