          ]
        },
        "next_page_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^CH\\d{2}-P\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "chapter_id",
        "title",
        "order",
        "concept_ids",
        "body_markdown",
        "previous_page_id",
        "next_page_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CH\\d{2}$"
