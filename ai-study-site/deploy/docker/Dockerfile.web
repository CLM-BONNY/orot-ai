# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
ARG APP_REVISION=local
WORKDIR /build/ai-study-site/frontend
COPY ai-study-site/frontend/package*.json ./
RUN npm ci
COPY ai-study-site/frontend ./
COPY ai-study-site/ai-review-example.json ../ai-review-example.json
COPY data-design /build/data-design
RUN npm run build && node -e "require('node:fs').writeFileSync('dist/release.json', JSON.stringify({code_revision:process.env.APP_REVISION}))"
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
ARG APP_REVISION=local
LABEL org.opencontainers.image.title="orot-ai-web" org.opencontainers.image.revision=$APP_REVISION
ENV API_UPSTREAM=127.0.0.1:8000 NGINX_RESOLVER=169.254.169.253 TRUSTED_PROXY_CIDR=10.0.0.0/16 SITE_AUTH_MODE=off
COPY --from=build /build/ai-study-site/frontend/dist /usr/share/nginx/html
COPY ai-study-site/deploy/docker/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 ai-study-site/deploy/docker/web/15-site-auth.sh /docker-entrypoint.d/15-site-auth.sh
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
