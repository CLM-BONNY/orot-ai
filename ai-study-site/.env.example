# The app reads .env.local at startup. No OpenAI account or key is required.
INFERENCE_PROVIDER=ollama
INFERENCE_BASE_URL=http://127.0.0.1:11535
MODEL_NAME=qwen3.5:9b-q4_K_M
INFERENCE_TIMEOUT_SECONDS=180
MAX_OUTPUT_TOKENS=384
REVIEW_MAX_OUTPUT_TOKENS=1536
STRUCTURED_CONTEXT_LENGTH=4096
# To start the already-downloaded Ollama runtime, set these absolute paths locally.
# OLLAMA_BINARY=/absolute/path/to/ollama
# OLLAMA_MODELS=/absolute/path/to/models
# Future self-hosted server: INFERENCE_PROVIDER=openai_compatible
# INFERENCE_BASE_URL=http://private-gpu-server:8000/v1
# MODEL_NAME=deployed-model-name
